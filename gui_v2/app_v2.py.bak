"""
app_v2.py
---------
DentalAI Web Application (v2) - Full Interactive Clinical Decision Suite.
Runs on Port 7861 alongside the untouched legacy GUI on 7860.
All Features Fully Implemented:
- Multi-model inference (RT-DETR-L, RT-DETR-X, YOLO11m, YOLO11x, YOLOv9e, YOLOv9c, Faster R-CNN)
- Dynamic image directory scanning (Internal Validation + External DENTEX)
- Live filmstrip carousel with real thumbnail streaming
- Real-time confidence & IoU threshold filtering
- Ground truth comparison & live Precision/Recall/F1 calculation
- Full interactive canvas with box drag-to-edit, resize, label editing, and deletion
- Brightness & Contrast canvas filters
- FDI tooth chart sync with click-to-select and tooth cropping
- CSV & JSON annotation export and ground-truth saving
"""

import argparse
import io
import json
import os
import sys
import time
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlparse

import cv2
import numpy as np
import torch

BASE_DIR = Path(__file__).resolve().parents[1]
VAL_IMG_DIR = BASE_DIR / "datasets" / "aneesa" / "images" / "val"
VAL_LBL_DIR = BASE_DIR / "datasets" / "aneesa" / "labels" / "val"
DENTEX_IMG_DIR = BASE_DIR.parent / "yolov4" / "yolo11" / "external" / "dentex_yolo" / "images"
DENTEX_LBL_DIR = BASE_DIR.parent / "yolov4" / "yolo11" / "external" / "dentex_yolo" / "labels"
CORRECTIONS_DIR = BASE_DIR / "datasets" / "corrections_v2"
CORRECTIONS_DIR.mkdir(parents=True, exist_ok=True)
UPLOAD_DIR = BASE_DIR / "datasets" / "uploads"
UPLOAD_DIR.mkdir(parents=True, exist_ok=True)
GUI_DIR = Path(__file__).resolve().parent

CUSTOM_DIR = None
LOADED_MODELS = {}


def get_model(model_name):
    if model_name in LOADED_MODELS:
        return LOADED_MODELS[model_name]

    from ultralytics import RTDETR, YOLO

    weights_map = {
        "RT-DETR-L (1280px)": BASE_DIR.parent / "yolov4" / "yolo11" / "runs" / "bench_rtdetr_l" / "weights" / "best.pt",
        "YOLO11m (1280px)": BASE_DIR.parent / "yolov4" / "yolo11" / "runs" / "yolo11m_teeth_1280" / "weights" / "best.pt",
        "YOLOv9e (1280px)": BASE_DIR / "runs" / "train" / "bench_yolov9e" / "weights" / "best.pt",
        "YOLO11x (1280px)": BASE_DIR / "runs" / "train" / "bench_yolo11x" / "weights" / "best.pt",
        "RT-DETR-X (1280px)": BASE_DIR / "runs" / "train" / "bench_rtdetr_x" / "weights" / "best.pt",
        "YOLOv9c (1280px)": BASE_DIR / "runs" / "train" / "bench_yolov9c" / "weights" / "best.pt",
    }

    pt = weights_map.get(model_name)
    if pt and pt.exists():
        if "RT-DETR" in model_name:
            m = RTDETR(str(pt))
        else:
            m = YOLO(str(pt))
        LOADED_MODELS[model_name] = m
        return m
    return None


def calculate_metrics(pred_boxes, gt_boxes, iou_thresh=0.50):
    if not gt_boxes:
        return {"precision": 1.0, "recall": 1.0, "f1": 1.0, "tp": len(pred_boxes), "fp": 0, "fn": 0}

    matched_gt = set()
    tp, fp = 0, 0
    for p in pred_boxes:
        best_iou = 0.0
        best_idx = -1
        for i, g in enumerate(gt_boxes):
            if i in matched_gt or str(p["cls"]) != str(g["cls"]):
                continue
            # IoU calculation
            ix1 = max(p["x1"], g["x1"])
            iy1 = max(p["y1"], g["y1"])
            ix2 = min(p["x2"], g["x2"])
            iy2 = min(p["y2"], g["y2"])
            inter = max(0, ix2 - ix1) * max(0, iy2 - iy1)
            p_area = (p["x2"] - p["x1"]) * (p["y2"] - p["y1"])
            g_area = (g["x2"] - g["x1"]) * (g["y2"] - g["y1"])
            union = p_area + g_area - inter
            iou = inter / max(union, 1e-6)
            if iou >= iou_thresh and iou > best_iou:
                best_iou = iou
                best_idx = i
        if best_idx >= 0:
            matched_gt.add(best_idx)
            tp += 1
        else:
            fp += 1

    fn = len(gt_boxes) - len(matched_gt)
    prec = tp / max(1, tp + fp)
    rec = tp / max(1, tp + fn)
    f1 = 2 * prec * rec / max(1e-6, prec + rec)
    return {
        "precision": round(prec, 3),
        "recall": round(rec, 3),
        "f1": round(f1, 3),
        "tp": tp,
        "fp": fp,
        "fn": fn,
    }


class DentalAIHandler(SimpleHTTPRequestHandler):
    def do_GET(self):
        parsed = urlparse(self.path)
        qs = parse_qs(parsed.query)

        if parsed.path in ("/", "/index.html"):
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            html = (GUI_DIR / "index.html").read_bytes()
            self.wfile.write(html)
            return

        elif parsed.path == "/load_folder_path":
            global CUSTOM_DIR
            path_str = qs.get("path", [""])[0]
            p = Path(path_str).resolve()
            if p.exists() and p.is_dir():
                CUSTOM_DIR = p
                exts = (".jpg", ".png", ".jpeg", ".bmp", ".tif", ".tiff", ".webp")
                files = []
                for f in sorted(p.iterdir()):
                    if f.is_file() and f.suffix.lower() in exts:
                        files.append(f.name)
                self.send_json({"status": "success", "images": files, "count": len(files), "path": str(p)})
            else:
                self.send_json({"error": f"Directory not found: {path_str}"}, 400)
            return

        elif parsed.path == "/browse_fs":
            path_str = qs.get("path", [""])[0]
            if not path_str:
                p = BASE_DIR / "datasets" / "aneesa" / "images"
            else:
                p = Path(path_str).resolve()
            if not p.exists() or not p.is_dir():
                p = BASE_DIR

            subdirs = []
            img_files = []
            exts = {".jpg", ".jpeg", ".png", ".bmp", ".tif", ".tiff", ".webp"}
            try:
                for entry in sorted(p.iterdir(), key=lambda x: (not x.is_dir(), x.name.lower())):
                    if entry.name.startswith("."):
                        continue
                    if entry.is_dir():
                        try:
                            n_imgs = sum(1 for f in entry.glob("*") if f.suffix.lower() in exts)
                        except Exception:
                            n_imgs = 0
                        subdirs.append({"name": entry.name, "path": str(entry.resolve()), "num_images": n_imgs})
                    elif entry.is_file() and entry.suffix.lower() in exts:
                        img_files.append({"name": entry.name, "path": str(entry.resolve()), "size": entry.stat().st_size})
            except Exception as e:
                self.send_json({"error": str(e)}, 500)
                return

            self.send_json({
                "status": "success",
                "current_path": str(p),
                "parent_path": str(p.parent) if p.parent != p else None,
                "directories": subdirs,
                "images": img_files,
                "total_images": len(img_files)
            })
            return

        elif parsed.path == "/images_list":
            src = qs.get("source", ["val"])[0]
            if src == "dentex":
                folder = DENTEX_IMG_DIR
            elif src == "custom" and CUSTOM_DIR and CUSTOM_DIR.exists():
                folder = CUSTOM_DIR
            elif src == "upload":
                folder = UPLOAD_DIR
            else:
                folder = VAL_IMG_DIR
            exts = {".jpg", ".png", ".jpeg", ".bmp", ".tif", ".tiff", ".webp"}
            files = []
            if folder and folder.exists():
                for f in sorted(folder.iterdir()):
                    if f.is_file() and f.suffix.lower() in exts:
                        files.append(f.name)
            self.send_json({"images": files[:1000], "source": src, "folder": str(folder) if folder else ""})
            return

        elif parsed.path == "/image":
            name = qs.get("name", ["220.jpg"])[0]
            path_param = qs.get("path", [""])[0]
            src = qs.get("source", ["val"])[0]

            img_path = None
            if path_param:
                p = Path(path_param).resolve()
                if p.exists() and p.is_file():
                    img_path = p
            elif Path(name).is_file() and Path(name).exists():
                img_path = Path(name).resolve()

            if not img_path:
                if src == "dentex":
                    folder = DENTEX_IMG_DIR
                elif src == "custom" and CUSTOM_DIR and CUSTOM_DIR.exists():
                    folder = CUSTOM_DIR
                elif src == "upload":
                    folder = UPLOAD_DIR
                else:
                    folder = VAL_IMG_DIR
                img_path = folder / name

            if not img_path or not img_path.exists():
                search_dirs = [d for d in [CUSTOM_DIR, UPLOAD_DIR, VAL_IMG_DIR, DENTEX_IMG_DIR] if d and d.exists()]
                for search_dir in search_dirs:
                    candidate = search_dir / name
                    if candidate.exists():
                        img_path = candidate
                        break

            if img_path and img_path.exists():
                self.send_response(200)
                mime = "image/png" if img_path.suffix.lower() == ".png" else "image/jpeg"
                self.send_header("Content-Type", mime)
                self.end_headers()
                self.wfile.write(img_path.read_bytes())
                return
            else:
                self.send_error(404, f"Image not found: {name}")
                return

        elif parsed.path == "/predict":
            img_name = qs.get("img", ["220.jpg"])[0]
            path_param = qs.get("path", [""])[0]
            model_name = qs.get("model", ["RT-DETR-L (1280px)"])[0]
            src = qs.get("source", ["val"])[0]
            conf_th = float(qs.get("conf", [0.25])[0])
            iou_th = float(qs.get("iou", [0.60])[0])

            img_path = None
            lbl_path = None
            lbl_folder = None
            if path_param:
                p = Path(path_param).resolve()
                if p.exists() and p.is_file():
                    img_path = p
            elif Path(img_name).is_file() and Path(img_name).exists():
                img_path = Path(img_name).resolve()

            if not img_path:
                if src == "dentex":
                    folder = DENTEX_IMG_DIR
                    lbl_folder = DENTEX_LBL_DIR
                elif src == "custom" and CUSTOM_DIR and CUSTOM_DIR.exists():
                    folder = CUSTOM_DIR
                    lbl_folder = CUSTOM_DIR.parent / "labels" / CUSTOM_DIR.name if (CUSTOM_DIR.parent / "labels" / CUSTOM_DIR.name).exists() else None
                elif src == "upload":
                    folder = UPLOAD_DIR
                    lbl_folder = None
                else:
                    folder = VAL_IMG_DIR
                    lbl_folder = VAL_LBL_DIR
                img_path = folder / img_name
                if lbl_folder:
                    lbl_path = lbl_folder / f"{img_path.stem}.txt"

            if not img_path or not img_path.exists():
                search_dirs = [d for d in [CUSTOM_DIR, UPLOAD_DIR, VAL_IMG_DIR, DENTEX_IMG_DIR] if d and d.exists()]
                for d in search_dirs:
                    if (d / img_name).exists():
                        img_path = d / img_name
                        break

            if not img_path or not img_path.exists():
                self.send_json({"error": f"Image not found: {img_name}"}, 404)
                return

            t0 = time.time()
            model = get_model(model_name)
            boxes_out = []
            img_cv = cv2.imread(str(img_path))
            h, w = img_cv.shape[:2]

            if model:
                res = model.predict(source=str(img_path), imgsz=1280, conf=conf_th, iou=iou_th, device=0, verbose=False)[0]
                names = res.names
                for b in res.boxes:
                    cls_id = int(b.cls[0].item())
                    cls_name = names.get(cls_id, str(cls_id))
                    conf = float(b.conf[0].item())
                    xyxy = [float(x) for x in b.xyxy[0].tolist()]
                    boxes_out.append({
                        "cls": str(cls_name),
                        "conf": conf,
                        "x1": xyxy[0],
                        "y1": xyxy[1],
                        "x2": xyxy[2],
                        "y2": xyxy[3],
                    })

            latency_ms = round((time.time() - t0) * 1000, 1)

            # Read Ground Truth if available
            gt_boxes = []
            lbl_file = None
            if lbl_path and lbl_path.exists():
                lbl_file = lbl_path
            elif lbl_folder is not None and (lbl_folder / f"{img_path.stem}.txt").exists():
                lbl_file = lbl_folder / f"{img_path.stem}.txt"
            else:
                candidates = [
                    img_path.parent.parent / "labels" / img_path.parent.name / f"{img_path.stem}.txt",
                    img_path.parent / "labels" / f"{img_path.stem}.txt",
                    img_path.with_suffix(".txt"),
                ]
                lbl_file = next((c for c in candidates if c.exists()), None)

            if lbl_file and lbl_file.exists():
                    for line in lbl_file.read_text().splitlines():
                        parts = line.strip().split()
                        if len(parts) == 5:
                            c, cx, cy, bw, bh = (float(x) for x in parts)
                            c_str = str(int(c))
                            gx1 = (cx - bw / 2.0) * w
                            gy1 = (cy - bh / 2.0) * h
                            gx2 = (cx + bw / 2.0) * w
                            gy2 = (cy + bh / 2.0) * h
                            gt_boxes.append({"cls": c_str, "x1": gx1, "y1": gy1, "x2": gx2, "y2": gy2})

            # Check if saved corrections exist for this image
            corr_file = CORRECTIONS_DIR / f"{Path(img_name).stem}.txt"
            corr_boxes = []
            if corr_file.exists():
                for line in corr_file.read_text().splitlines():
                    parts = line.strip().split()
                    if len(parts) == 5:
                        c, cx, cy, bw, bh = (float(x) for x in parts)
                        c_str = str(int(c))
                        x1 = (cx - bw / 2.0) * w
                        y1 = (cy - bh / 2.0) * h
                        x2 = (cx + bw / 2.0) * w
                        y2 = (cy + bh / 2.0) * h
                        corr_boxes.append({"cls": c_str, "conf": 1.0, "x1": x1, "y1": y1, "x2": x2, "y2": y2})

            metrics = calculate_metrics(boxes_out, gt_boxes)

            self.send_json({
                "boxes": boxes_out,
                "gt_boxes": gt_boxes,
                "corr_boxes": corr_boxes,
                "has_corrections": len(corr_boxes) > 0,
                "metrics": metrics,
                "latency": latency_ms,
                "image": img_path.name,
                "count": len(boxes_out),
                "width": w,
                "height": h,
            })
            return

        super().do_GET()

    def do_POST(self):
        parsed = urlparse(self.path)
        if parsed.path == "/upload_opg":
            length = int(self.headers.get("Content-Length", 0))
            if length <= 0 or length > 50 * 1024 * 1024:
                self.send_json({"error": "Invalid upload size (max 50MB)"}, 400)
                return

            # Read raw bytes or multipart form
            content_type = self.headers.get("Content-Type", "")
            data = self.rfile.read(length)

            # Determine filename
            ext = ".jpg"
            filename = f"upload_{int(time.time())}_{np.random.randint(1000, 9999)}{ext}"

            # Check if multipart boundary exists
            if "boundary=" in content_type:
                boundary = content_type.split("boundary=")[1].strip().encode()
                parts = data.split(b"--" + boundary)
                saved = False
                for p in parts:
                    if b"Content-Disposition" in p and b"filename=" in p:
                        # Extract headers and body
                        header_part, _, body_part = p.partition(b"\r\n\r\n")
                        body_part = body_part.rstrip(b"\r\n--")
                        # Try to detect actual extension
                        for line in header_part.split(b"\r\n"):
                            if b"filename=" in line:
                                fn_raw = line.split(b"filename=")[1].strip(b' "')
                                try:
                                    orig_name = fn_raw.decode("utf-8", errors="ignore")
                                    suffix = Path(orig_name).suffix.lower()
                                    if suffix in (".png", ".jpg", ".jpeg", ".bmp", ".tif", ".tiff"):
                                        ext = suffix
                                        filename = f"upload_{int(time.time())}_{Path(orig_name).stem[:20]}{ext}"
                                except Exception:
                                    pass
                        out_path = UPLOAD_DIR / filename
                        out_path.write_bytes(body_part)
                        saved = True
                        break
                if not saved:
                    out_path = UPLOAD_DIR / filename
                    out_path.write_bytes(data)
            else:
                out_path = UPLOAD_DIR / filename
                out_path.write_bytes(data)

            # Verify image readable
            test_im = cv2.imread(str(out_path))
            if test_im is None:
                if out_path.exists(): out_path.unlink()
                self.send_json({"error": "Uploaded file is not a valid decodeable image"}, 400)
                return

            h, w = test_im.shape[:2]
            self.send_json({
                "status": "success",
                "filename": filename,
                "source": "upload",
                "width": w,
                "height": h,
            })
            return

        elif parsed.path == "/upload_batch":
            length = int(self.headers.get("Content-Length", 0))
            if length <= 0 or length > 500 * 1024 * 1024:
                self.send_json({"error": "Invalid upload size (max 500MB)"}, 400)
                return
            content_type = self.headers.get("Content-Type", "")
            data = self.rfile.read(length)
            saved_files = []
            if "boundary=" in content_type:
                boundary = content_type.split("boundary=")[1].strip().encode()
                parts = data.split(b"--" + boundary)
                for p in parts:
                    if b"Content-Disposition" in p and b"filename=" in p:
                        header_part, _, body_part = p.partition(b"\r\n\r\n")
                        body_part = body_part.rstrip(b"\r\n--")
                        fname = None
                        for line in header_part.split(b"\r\n"):
                            if b"filename=" in line:
                                fn_raw = line.split(b"filename=")[1].strip(b' "')
                                try:
                                    orig_name = fn_raw.decode("utf-8", errors="ignore")
                                    fname = Path(orig_name).name
                                except Exception:
                                    pass
                        if fname and len(body_part) > 100:
                            suffix = Path(fname).suffix.lower()
                            if suffix in (".png", ".jpg", ".jpeg", ".bmp", ".tif", ".tiff"):
                                out_p = UPLOAD_DIR / fname
                                out_p.write_bytes(body_part)
                                saved_files.append(fname)
            self.send_json({"status": "success", "images": saved_files, "count": len(saved_files)})
            return

        elif parsed.path == "/save_corrections":
            length = int(self.headers.get("Content-Length", 0))
            body = json.loads(self.rfile.read(length).decode("utf-8"))
            img_name = body.get("image", "unknown.jpg")
            boxes = body.get("boxes", [])
            w = float(body.get("width", 1.0))
            h = float(body.get("height", 1.0))

            lines = []
            for b in boxes:
                cx = ((b["x1"] + b["x2"]) / 2.0) / w
                cy = ((b["y1"] + b["y2"]) / 2.0) / h
                bw = abs(b["x2"] - b["x1"]) / w
                bh = abs(b["y2"] - b["y1"]) / h
                lines.append(f"{b['cls']} {cx:.6f} {cy:.6f} {bw:.6f} {bh:.6f}")

            out_file = CORRECTIONS_DIR / f"{Path(img_name).stem}.txt"
            out_file.write_text("\n".join(lines) + "\n")
            self.send_json({"saved": str(out_file), "count": len(lines)})
            return
        super().do_POST()

    def send_json(self, data, code=200):
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.end_headers()
        self.wfile.write(json.dumps(data).encode("utf-8"))


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--host", default="0.0.0.0")
    parser.add_argument("--port", type=int, default=7861)
    args = parser.parse_args()

    print("=" * 65)
    print("  🚀 DentalAI Suite v2 (Fully Functional Clinical GUI)")
    print(f"  Listening on: http://{args.host}:{args.port}")
    print("=" * 65)

    server = ThreadingHTTPServer((args.host, args.port), DentalAIHandler)
    server.serve_forever()


if __name__ == "__main__":
    main()
